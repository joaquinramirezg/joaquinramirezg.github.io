---
import '../styles/site.css';
import '../styles/v2.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  path: string;            // canonical path, e.g. "/" or "/work/hr-copilot/"
  ogTitle?: string;
  ogImage?: string;        // absolute path on the site
  ogAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
  nav?: 'work' | 'projects' | '';
  skipTo?: string;
}
const {
  title, description, path, ogTitle = title, ogImage = '/og.png?v=2',
  ogAlt = 'Joaquin Ramirez, machine learning engineer and data scientist',
  ogType = 'article', jsonLd = [], nav = '', skipTo = '#content',
} = Astro.props;
const site = 'https://joaquinramirez.dev';
const url = site + path;
const img = site + ogImage;
const EMAIL = 'joaquin.elias.ramirez.gutierrez.2027@anderson.ucla.edu';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Joaquin Ramirez">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={img}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={img}>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0f141b" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" sizes="48x48 32x32 16x16" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="preload" href="/inter-var.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>
  // Apply a saved theme choice before first paint; otherwise the system setting wins.
  try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
</script>
<!-- Cookieless analytics (Umami Cloud): sets no cookies, stores no personal data, honors Do Not Track. -->
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="36142a64-7544-46cd-b173-531dcf48a387" data-do-not-track="true"></script>
<script is:inline defer src="/site.js?v=4"></script>
{jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<slot name="head" />
</head>
<body>

<a class="skip-link" href={skipTo}>Skip to content</a>

<nav class="site-nav" aria-label="Site">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="Joaquin Ramirez, home"><span class="brand-full">Joaquin Ramirez</span><span class="brand-short">JR</span></a>
    <a class="nav-link" href="/#work" aria-current={nav === 'work' ? 'true' : undefined}>Work</a>
    <a class="nav-link" href="/#projects" aria-current={nav === 'projects' ? 'true' : undefined}>Projects</a>
    <a class="nav-link" href="/#about">About</a>
    <a class="nav-link" href="/#contact">Contact</a>
    <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Light or dark theme">
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>
  </div>
</nav>

<slot />

<footer id="contact">
  <div class="wrap wide footer-grid">
    <div>
      <h2 class="footer-title">Let's talk</h2>
      <p class="footer-lead">Recruiting for Summer 2027 in ML engineering, data science or AI product? Email me, it is the fastest way to reach me.</p>
      <div class="email-row">
        <code class="email-addr">{EMAIL}</code>
        <button class="copy-email" type="button" data-email={EMAIL}>Copy</button>
        <a class="email-open" href={`mailto:${EMAIL}`}>Open in mail app</a>
      </div>
    </div>
    <ul class="footer-links">
      <li><Icon name="pin" /> Los Angeles, California</li>
      <li><a href="https://www.linkedin.com/in/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a></li>
      <li><a href="https://github.com/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="github" /> GitHub</a></li>
      <li><a href="/resume.pdf" target="_blank" rel="noopener"><Icon name="file" /> Resume</a></li>
      <li><a href="/privacy.html">Privacy</a></li>
    </ul>
  </div>
</footer>
<div class="toast" role="status" aria-live="polite"></div>

<script is:inline>
(function () {
  // Theme toggle: flips the current effective theme and remembers it.
  var root = document.documentElement;
  var btn = document.querySelector('.theme-toggle');
  function effective() {
    var t = root.getAttribute('data-theme');
    if (t) return t;
    return window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  if (btn) btn.addEventListener('click', function () {
    var next = effective() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
    try { if (window.umami) window.umami.track('theme', { to: next }); } catch (e) {}
  });
  // Copy email: clipboard, with a visible confirmation; mailto stays as the fallback.
  var toast = document.querySelector('.toast'), tt;
  function say(msg) { if (!toast) return; toast.textContent = msg; toast.classList.add('show'); clearTimeout(tt); tt = setTimeout(function () { toast.classList.remove('show'); }, 2200); }
  document.querySelectorAll('[data-email]').forEach(function (b) {
    b.addEventListener('click', function (e) {
      var addr = b.getAttribute('data-email');
      e.preventDefault();
      function done() { say('Email copied: ' + addr); }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(addr).then(done, function () { location.href = 'mailto:' + addr; });
      else location.href = 'mailto:' + addr;
      try { if (window.umami) window.umami.track('email-copy', { from: b.closest('header') ? 'hero' : 'footer' }); } catch (e) {}
    });
  });
})();
</script>
<slot name="scripts" />
</body>
</html>
