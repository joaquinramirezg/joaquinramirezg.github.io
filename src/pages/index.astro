---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import jsonLd from '../data/home-jsonld.json';
import skills from '../data/skills.html?raw';
import education from '../data/education.html?raw';
import about from '../data/about.html?raw';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const hasPage = (e: { body?: string }) => !!(e.body && e.body.trim());

const EMAIL = 'joaquin.elias.ramirez.gutierrez.2027@anderson.ucla.edu';
const copilot = work.find((w) => w.id === 'hr-copilot')!;
const alwayshome = projects.find((p) => p.id === 'alwayshome')!;
const genie = projects.find((p) => p.id === 'genie')!;
---
<Base
  title="Joaquin Ramirez · ML Engineer / Data Scientist · UCLA Anderson MSBA"
  description="Machine Learning Engineer and Data Scientist. LLM copilots and agents, RAG, fraud detection, and optimization, all shipped to production. MSBA candidate at UCLA Anderson."
  ogTitle="Joaquin Ramirez · ML Engineer / Data Scientist"
  path="/"
  ogType="website"
  jsonLd={jsonLd}
  skipTo="#featured"
>
<header id="top">
  <div class="wrap wide hero-grid">
    <div class="hero-text">
      <p class="status"><span class="dot" aria-hidden="true"></span>Open to Summer 2027 internships</p>
      <div class="kicker">Machine Learning Engineer / Data Scientist</div>
      <h1>Joaquin Ramirez</h1>
      <p class="subtitle">I've spent three years building GenAI products and predictive models that made it to production. Now an MSBA candidate at UCLA Anderson.</p>
      <p class="meta-line">Los Angeles, CA · Seeking Summer 2027 internships in machine learning engineering, data science, and AI product management</p>
      <div class="links">
        <a class="primary" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
        <a href="https://www.linkedin.com/in/joaquinramirezg" target="_blank" rel="me noopener">LinkedIn</a>
        <a href={`mailto:${EMAIL}`} data-email={EMAIL} title={EMAIL}>Copy email</a>
        <a href="https://github.com/joaquinramirezg" target="_blank" rel="me noopener">GitHub</a>
      </div>
    </div>
    <img class="hero-photo" src="/me.jpg" alt="Joaquin Ramirez" width="400" height="400" fetchpriority="high">
  </div>
  <div class="wrap wide">
    <ul class="proof">
      <li><b>1300+ organizations</b><span>use the AI copilot I led</span></li>
      <li><b>35 banks</b><span>in the fraud detection network</span></li>
      <li><b>2 weeks → &lt;20 min</b><span>contract allocation for an exporter</span></li>
    </ul>
  </div>
</header>

<main id="content">

<section id="featured" aria-label="Featured">
  <div class="wrap wide">
    <h2>Start here</h2>
    <div class="featured">
      <a class="tile" href="/work/hr-copilot/">
        <div class="tile-visual tile-number">
          <span class="tile-big">9x</span>
          <span class="tile-small">copilot adoption · 1300+ organizations · 48K+ users</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Case study · Crehana · {copilot.data.minutes} min</span>
          <h3>{copilot.data.pageTitle}</h3>
          <p>Agents, reliability, and where personal data sat.</p>
        </div>
      </a>
      <a class="tile" href="/projects/alwayshome/">
        <div class="tile-visual"><img src="/p/alwayshome.webp" alt="" width="800" height="480" loading="lazy" decoding="async"></div>
        <div class="tile-body">
          <span class="tile-kind">Project · live app · Nov 2026</span>
          <h3>AlwaysHome</h3>
          <p>Which wildfire fixes pay back first. AI reads the policy, never sets a number.</p>
        </div>
      </a>
      <a class="tile" href={genie.data.code} target="_blank" rel="noopener">
        <div class="tile-visual project-thumb" set:html={genie.data.thumb} />
        <div class="tile-body">
          <span class="tile-kind">Thesis · UTEC · 2023</span>
          <h3>G.E.N.I.E.</h3>
          <p>LoRA fine-tuning Falcon-7B: eval loss down 84%.</p>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="work">
  <div class="wrap wide">
    <h2>Work</h2>
    <p class="section-lead">Production systems, most recent first. The bigger ones have a case study: the tradeoffs, what failed, and how each result was measured.</p>
    <div class="grid-2">
      {work.map((w) => (
        <article class:list={['card', { compact: w.data.compact }]}>
          <h3>{hasPage(w) ? <a href={`/work/${w.id}/`}>{w.data.title}</a> : w.data.title}</h3>
          <span class="where">{w.data.where}</span>
          <p set:html={w.data.summary} />
          {w.data.metrics.length > 0 && (
            <div class="metrics">{w.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
          )}
          <p class="tags">{w.data.stack}</p>
          {hasPage(w) && (
            <a class="case-link" href={`/work/${w.id}/`}>Read the case study <span>· {w.data.minutes} min</span></a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<section id="projects">
  <div class="wrap wide">
    <h2>Projects</h2>
    <p class="section-lead">Built outside a job. Each one links to its code; the biggest ones have their own page.</p>
    <ul class="projects grid-2">
      {projects.map((p) => (
        <li class="card project stacked" id={`project-${p.id}`}>
          <div class="project-thumb" set:html={p.data.thumb} />
          <div class="project-body">
            <h3>{hasPage(p) ? <a href={`/projects/${p.id}/`}>{p.data.title}</a> : p.data.title}</h3>
            <span class="where">{p.data.where}</span>
            <p set:html={p.data.summary} />
            <p class="shows"><b>Shows:</b> {p.data.shows}</p>
            {p.data.metrics.length > 0 && (
              <div class="metrics">{p.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
            )}
            <p class="tags">{p.data.stack}</p>
            <div class="project-links">
              {hasPage(p) && <a class="case-link" href={`/projects/${p.id}/`}>Project page</a>}
              {p.data.demo && <a class="text-link" href={p.data.demo} target="_blank" rel="noopener">Live app ↗</a>}
              {p.data.code && <a class="text-link" href={p.data.code} target="_blank" rel="noopener">Code and write-up ↗</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="skills">
  <div class="wrap wide">
    <h2>Skills</h2>
    <Fragment set:html={skills} />
  </div>
</section>

<section id="education">
  <div class="wrap wide">
    <h2>Education</h2>
    <Fragment set:html={education} />
  </div>
</section>

<section id="about">
  <div class="wrap wide">
    <h2>About</h2>
    <Fragment set:html={about} />
  </div>
</section>

</main>

<Fragment slot="scripts">
<script is:inline>
// Old links to collapsed case studies (#case-...) now go to their own pages.
(function () {
  var map = { 'case-copilot': 'hr-copilot', 'case-rag': 'retrieval-pipeline', 'case-fishmeal': 'contract-allocation', 'case-fraud': 'fraud-detection' };
  var k = location.hash.slice(1);
  if (map[k]) location.replace('/work/' + map[k] + '/' + location.search);
})();
// Highlight the nav link of the section on screen.
(function () {
  if (!('IntersectionObserver' in window)) return;
  var links = {};
  document.querySelectorAll('.site-nav a.nav-link').forEach(function (a) { links[a.getAttribute('href').replace('/#', '')] = a; });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      Object.keys(links).forEach(function (k) { links[k].removeAttribute('aria-current'); });
      if (links[e.target.id]) links[e.target.id].setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  ['work', 'projects', 'about', 'contact'].forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
})();
</script>
</Fragment>
</Base>
