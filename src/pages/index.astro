---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import jsonLd from '../data/home-jsonld.json';
import skills from '../data/skills.json';
import education from '../data/education.json';
import about from '../data/about.html?raw';
import experience from '../data/experience.json';
import principles from '../data/principles.json';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const hasPage = (e: { body?: string }) => !!(e.body && e.body.trim());

const EMAIL = 'joaquin.elias.ramirez.gutierrez.2027@anderson.ucla.edu';
const copilot = work.find((w) => w.id === 'hr-copilot')!;
const alwayshome = projects.find((p) => p.id === 'alwayshome')!;
const fraud = work.find((w) => w.id === 'fraud-detection')!;
const byId = Object.fromEntries(work.map((w) => [w.id, w]));
const mainProjects = projects.filter((p) => !p.data.earlier);
const earlierProjects = projects.filter((p) => p.data.earlier);
---
<Base
  title="Joaquin Ramirez · ML Engineer / Data Scientist · UCLA Anderson MSBA"
  description="Machine Learning Engineer and Data Scientist. LLM copilots and agents, RAG, fraud detection, and optimization, all shipped to production. MSBA candidate at UCLA Anderson."
  ogTitle="Joaquin Ramirez · ML Engineer / Data Scientist"
  path="/"
  ogType="website"
  jsonLd={jsonLd}
  skipTo="#featured"
>
<header id="top">
  <div class="wrap wide hero-grid">
    <div class="hero-text">
      <div class="kicker">Machine Learning Engineer · Data Scientist</div>
      <h1>Joaquin Ramirez</h1>
      <p class="subtitle">I led Crehana's GenAI copilot and its agents, used by 1300+ organizations and 48K+ users. Over three years building GenAI products and predictive models; now earning a master's in business analytics at UCLA Anderson.</p>
      <ul class="hero-facts">
        <li><Icon name="pin" /> Los Angeles, California</li>
        <li><Icon name="school" /> M.S. Business Analytics, UCLA Anderson · Dec 2027</li>
      </ul>
      <div class="links">
        <a class="primary" href="/resume.pdf" target="_blank" rel="noopener"><Icon name="file" /> Resume</a>
        <a href="https://www.linkedin.com/in/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a href="https://github.com/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="github" /> GitHub</a>
        <a href={`mailto:${EMAIL}`} data-email={EMAIL} title={EMAIL}><Icon name="mail" /> Copy email</a>
        <a href="https://calendly.com/joaquinramirezg/30min" target="_blank" rel="noopener"><Icon name="calendar" /> Book a call</a>
      </div>
      <p class="avail"><span class="dot" aria-hidden="true"></span>Open to Summer 2027 internships in ML engineering, data science and AI product management</p>
    </div>
    <img class="hero-photo" src="/me.jpg" alt="Joaquin Ramirez" width="400" height="400" fetchpriority="high">
  </div>
</header>

<main id="content">

<section id="featured" aria-label="Featured">
  <div class="wrap wide">
    <h2>Start here</h2>
    <div class="featured">
      <a class="tile" href="/work/hr-copilot/">
        <div class="tile-visual tile-number">
          <span class="tile-big">9x</span>
          <span class="tile-small">copilot adoption · 1300+ organizations · 48K+ users</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Case study · Crehana · {copilot.data.minutes} min</span>
          <h3>{copilot.data.pageTitle}</h3>
          <p>Agents, reliability, and whether to tell a user the data exists but is not theirs.</p>
        </div>
      </a>
      <a class="tile" href="/work/fraud-detection/">
        <div class="tile-visual tile-number">
          <span class="tile-big">35</span>
          <span class="tile-small">financial institutions · real time · no fraud labels</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Case study · Canvia</span>
          <h3>{fraud.data.pageTitle}</h3>
          <p>No fraud labels, so unsupervised. Took over an MVP flagging ~9%; redesigned features and model to the client's ~2% threshold.</p>
        </div>
      </a>
      <a class="tile" href="/projects/alwayshome/">
        <div class="tile-visual tile-number">
          <span class="tile-big">0.80</span>
          <span class="tile-small">AUC · 0.68 on unseen neighborhoods · 22,071 CAL FIRE inspections</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Project · live app · Nov 2026</span>
          <h3>AlwaysHome</h3>
          <p>Which wildfire fixes pay back first. AI reads the policy, never sets a number.</p>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="work">
  <div class="wrap wide">
    <h2>Experience</h2>
    <p class="section-lead">Systems built at work, most recent first. Four have a full case study: the tradeoffs, what failed, and how each result was measured.</p>
    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <div class="job-head">
            <h3>{job.company}</h3>
            <p class="job-title">{job.title}</p>
            <p class="job-meta">{job.dates}<br>{job.about}</p>
          </div>
          <div class="job-body">
            {job.scope && <p class="job-scope">{job.scope}</p>}
            {job.systems.map((id) => byId[id]).map((w) => (
              <article class="system">
                <h4>{hasPage(w) ? <a href={`/work/${w.id}/`}>{w.data.title}</a> : w.data.title}</h4>
                {w.data.metrics.length > 0 && (
                  <div class="metrics">{w.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
                )}
                <p set:html={w.data.summary} />
                <p class="tags">{w.data.stack}</p>
                {hasPage(w) && (
                  <a class="case-link" href={`/work/${w.id}/`}>Read the case study{(w.data.minutes ?? 0) >= 2 && <span> · {w.data.minutes} min</span>}</a>
                )}
              </article>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="principles">
  <div class="wrap wide">
    <h2>How I work</h2>
    <p class="section-lead">Four habits I bring to every system, each taken from a case study on this site.</p>
    <div class="principles">
      {principles.map((p, i) => (
        <a class="principle" href={p.href}>
          <span class="principle-n">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <span class="principle-from">{p.from} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="projects">
  <div class="wrap wide">
    <h2>Projects</h2>
    <p class="section-lead">Built outside a job, each with its code.</p>
    <div class="prows">
      {mainProjects.map((p) => (
        <article class="prow" id={`project-${p.id}`}>
          <figure class="frame">
            {p.data.demo && <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.data.demo.replace('https://', '')}</span></div>}
            {p.id === 'alwayshome' ? (
              <div class="frame-media">
                <video class="auto-loop" muted loop playsinline preload="none" poster="/projects/alwayshome/loop-r-poster.webp" width="960" height="600" aria-label="AlwaysHome plan screen: as the budget slider moves, the ranked fire-safety fixes and the estimated chance of losing the house update">
                  <source src="/projects/alwayshome/loop-m.webm" type="video/webm" media="(max-width: 600px)">
                  <source src="/projects/alwayshome/loop-m.mp4" type="video/mp4" media="(max-width: 600px)">
                  <source src="/projects/alwayshome/loop-r.webm" type="video/webm">
                  <source src="/projects/alwayshome/loop-r.mp4" type="video/mp4">
                </video>
                <button class="loop-toggle" type="button" aria-label="Play demo" hidden>Play</button>
              </div>
            ) : (
              <div class="frame-media frame-chart" set:html={p.data.thumb} />
            )}
            <figcaption>{p.id === 'alwayshome' ? 'The live app: the plan rebuilds as the budget moves. Dollar figures are placeholders.' : 'Evaluation loss and perplexity, before and after LoRA fine-tuning.'}</figcaption>
          </figure>
          <div class="prow-body">
            <span class="prow-kind">{p.data.where}</span>
            <h3>{hasPage(p) ? <a href={`/projects/${p.id}/`}>{p.data.title}</a> : p.data.title}</h3>
            <p set:html={p.data.summary} />
            {p.data.metrics.length > 0 && (
              <div class="metrics">{p.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
            )}
            <p class="tags">{p.data.stack}</p>
            <div class="project-links">
              {hasPage(p) && <a class="case-link" href={`/projects/${p.id}/`}>Project page</a>}
              {p.data.demo && <a class="text-link" href={p.data.demo} target="_blank" rel="noopener">Live app ↗</a>}
              {p.data.code && <a class="text-link" href={p.data.code} target="_blank" rel="noopener">Code and write-up ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
    <h3 class="earlier-title">Earlier work</h3>
    <ul class="earlier">
      {earlierProjects.map((p) => (
        <li id={`project-${p.id}`}>
          <a href={p.data.code} target="_blank" rel="noopener">{p.data.short ?? p.data.title} ↗</a>
          <span>{p.data.oneLine}</span>
          <span class="earlier-where">{p.data.where}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="background">
  <div class="wrap wide background-grid">
    <div id="education">
      <h2>Education</h2>
      <ul class="edu-rows">
        {education.map((e) => (
          <li>
            <h3>{e.school}</h3>
            <p class="edu-degree">{e.degree}</p>
            <p class="edu-details">{e.details.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
    <div id="skills">
      <h2>Skills</h2>
      <dl class="stack-rows">
        {skills.map((s) => (
          <div><dt>{s.area}</dt><dd>{s.items.join(', ')}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap wide">
    <h2>About</h2>
    <div class="card about-card">
      <Fragment set:html={about} />
    </div>
  </div>
</section>

</main>

<Fragment slot="scripts">
<script is:inline>
// Old links to collapsed case studies (#case-...) now go to their own pages.
(function () {
  var map = { 'case-copilot': 'hr-copilot', 'case-rag': 'retrieval-pipeline', 'case-fishmeal': 'contract-allocation', 'case-fraud': 'fraud-detection' };
  var k = location.hash.slice(1);
  if (map[k]) location.replace('/work/' + map[k] + '/' + location.search);
})();
// Muted demo loop: plays only on screen, never under reduced motion or Save-Data.
(function () {
  var v = document.querySelector('video.auto-loop'); if (!v) return;
  if (window.matchMedia && matchMedia('(max-width: 600px)').matches) { v.poster = '/projects/alwayshome/loop-m-poster.webp'; v.classList.add('is-m'); }
  var btn = v.parentNode.querySelector('.loop-toggle'); btn.hidden = false;
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var save = navigator.connection && (navigator.connection.saveData || /2g/.test(navigator.connection.effectiveType || ''));
  var userPaused = !!(reduce || save), visible = false;
  function sync() { if (visible && !userPaused) { v.play().catch(function () {}); } else { v.pause(); } btn.textContent = v.paused || userPaused ? 'Play' : 'Pause'; btn.setAttribute('aria-label', (userPaused ? 'Play' : 'Pause') + ' demo'); }
  v.addEventListener('play', sync); v.addEventListener('pause', function () { btn.textContent = 'Play'; });
  btn.addEventListener('click', function () { userPaused = !userPaused; if (!userPaused) v.preload = 'auto'; sync(); });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { visible = e[0].isIntersecting; if (visible && !userPaused) v.preload = 'auto'; sync(); }, { threshold: 0.4 }).observe(v);
})();
// Highlight the nav link of the section on screen.
(function () {
  if (!('IntersectionObserver' in window)) return;
  var links = {};
  document.querySelectorAll('.site-nav a.nav-link').forEach(function (a) { links[a.getAttribute('href').replace('/#', '')] = a; });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      Object.keys(links).forEach(function (k) { links[k].removeAttribute('aria-current'); });
      if (links[e.target.id]) links[e.target.id].setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  ['work', 'projects', 'about', 'contact'].forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
})();
</script>
</Fragment>
</Base>
