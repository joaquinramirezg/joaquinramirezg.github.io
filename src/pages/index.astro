---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import jsonLd from '../data/home-jsonld.json';
import skills from '../data/skills.json';
import education from '../data/education.json';
import about from '../data/about.html?raw';
import experience from '../data/experience.json';
import principles from '../data/principles.json';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const hasPage = (e: { body?: string }) => !!(e.body && e.body.trim());

const EMAIL = 'joaquin.elias.ramirez.gutierrez.2027@anderson.ucla.edu';
const copilot = work.find((w) => w.id === 'hr-copilot')!;
const alwayshome = projects.find((p) => p.id === 'alwayshome')!;
const fraud = work.find((w) => w.id === 'fraud-detection')!;
const byId = Object.fromEntries(work.map((w) => [w.id, w]));
const mainProjects = projects.filter((p) => !p.data.earlier);
const earlierProjects = projects.filter((p) => p.data.earlier);
---
<Base
  title="Joaquin Ramirez · ML Engineer / Data Scientist · UCLA Anderson MSBA"
  description="Machine Learning Engineer and Data Scientist. LLM copilots and agents, RAG, fraud detection, and optimization, all shipped to production. MSBA candidate at UCLA Anderson."
  ogTitle="Joaquin Ramirez · ML Engineer / Data Scientist"
  path="/"
  ogType="website"
  jsonLd={jsonLd}
  skipTo="#featured"
>
<header id="top">
  <div class="wrap wide hero-grid">
    <div class="hero-text">
      <div class="kicker">Machine Learning Engineer · Data Scientist</div>
      <h1>Joaquin Ramirez</h1>
      <p class="subtitle">I led Crehana's GenAI copilot and its agents, used by 1300+ organizations and 48K+ users. Over three years of ML in production; now an MSBA candidate at UCLA Anderson.</p>
      <ul class="hero-facts">
        <li><Icon name="pin" /> Los Angeles, California</li>
        <li><Icon name="school" /> UCLA Anderson MSBA, Dec 2027</li>
      </ul>
      <div class="links">
        <a class="primary" href="/resume.pdf" target="_blank" rel="noopener"><Icon name="file" /> Resume</a>
        <a href="https://www.linkedin.com/in/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a href="https://github.com/joaquinramirezg" target="_blank" rel="me noopener"><Icon name="github" /> GitHub</a>
        <a href={`mailto:${EMAIL}`} data-email={EMAIL} title={EMAIL}><Icon name="mail" /> Copy email</a>
      </div>
      <p class="avail"><span class="dot" aria-hidden="true"></span>Open to Summer 2027 internships in ML engineering, data science and AI product management</p>
    </div>
    <img class="hero-photo" src="/me.jpg" alt="Joaquin Ramirez" width="400" height="400" fetchpriority="high">
  </div>
  <div class="wrap wide">
    <ul class="proof">
      <li><b>1300+ orgs · 48K+ users</b><span>on the AI copilot I led</span></li>
      <li><b>35 banks</b><span>in the fraud detection network</span></li>
      <li><b>2 weeks → &lt;20 min</b><span>contract allocation for an exporter</span></li>
    </ul>
  </div>
</header>

<main id="content">

<section id="featured" aria-label="Featured">
  <div class="wrap wide">
    <h2>Start here</h2>
    <div class="featured">
      <a class="tile" href="/work/hr-copilot/">
        <div class="tile-visual tile-number">
          <span class="tile-big">9x</span>
          <span class="tile-small">copilot adoption · 1300+ organizations · 48K+ users</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Case study · Crehana · {copilot.data.minutes} min</span>
          <h3>{copilot.data.pageTitle}</h3>
          <p>Agents, reliability, and where personal data sat.</p>
        </div>
      </a>
      <a class="tile" href="/work/fraud-detection/">
        <div class="tile-visual tile-number">
          <span class="tile-big">35</span>
          <span class="tile-small">financial institutions · real time · no fraud labels</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Case study · Canvia · {fraud.data.minutes} min</span>
          <h3>{fraud.data.pageTitle}</h3>
          <p>No fraud labels, so unsupervised. An MVP that flagged about 9% brought to the client's ~2%.</p>
        </div>
      </a>
      <a class="tile" href="/projects/alwayshome/">
        <div class="tile-visual tile-number">
          <span class="tile-big">0.80</span>
          <span class="tile-small">AUC · 0.68 on unseen neighborhoods · 22,071 CAL FIRE inspections</span>
        </div>
        <div class="tile-body">
          <span class="tile-kind">Project · live app · Nov 2026</span>
          <h3>AlwaysHome</h3>
          <p>Which wildfire fixes pay back first. AI reads the policy, never sets a number.</p>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="work">
  <div class="wrap wide">
    <h2>Experience</h2>
    <p class="section-lead">Production systems, most recent first. The bigger ones have a case study: the tradeoffs, what failed, and how each result was measured.</p>
    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <div class="job-head">
            <h3>{job.company}</h3>
            <p class="job-title">{job.title}</p>
            <p class="job-meta">{job.dates}<br>{job.about}</p>
          </div>
          <div class="job-body">
            {job.systems.map((id) => byId[id]).map((w) => (
              <article class="system">
                <h4>{hasPage(w) ? <a href={`/work/${w.id}/`}>{w.data.title}</a> : w.data.title}</h4>
                {w.data.metrics.length > 0 && (
                  <div class="metrics">{w.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
                )}
                <p set:html={w.data.summary} />
                <p class="tags">{w.data.stack}</p>
                {hasPage(w) && (
                  <a class="case-link" href={`/work/${w.id}/`}>Read the case study <span>· {w.data.minutes} min</span></a>
                )}
              </article>
            ))}
            {job.scope && <p class="job-scope">{job.scope}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="principles">
  <div class="wrap wide">
    <h2>How I work</h2>
    <p class="section-lead">Four habits I bring to every system, each taken from a case study on this site.</p>
    <div class="principles">
      {principles.map((p, i) => (
        <a class="principle" href={p.href}>
          <span class="principle-n">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <span class="principle-from">{p.from} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="projects">
  <div class="wrap wide">
    <h2>Projects</h2>
    <p class="section-lead">Built outside a job, each with its code.</p>
    <ul class="projects grid-2">
      {mainProjects.map((p) => (
        <li class="card project stacked" id={`project-${p.id}`}>
          <div class="project-thumb" set:html={p.data.thumb} />
          <div class="project-body">
            <h3>{hasPage(p) ? <a href={`/projects/${p.id}/`}>{p.data.title}</a> : p.data.title}</h3>
            <span class="where">{p.data.where}</span>
            <p set:html={p.data.summary} />
            {p.data.metrics.length > 0 && (
              <div class="metrics">{p.data.metrics.map((m) => <span class="metric">{m}</span>)}</div>
            )}
            <p class="tags">{p.data.stack}</p>
            <div class="project-links">
              {hasPage(p) && <a class="case-link" href={`/projects/${p.id}/`}>Project page</a>}
              {p.data.demo && <a class="text-link" href={p.data.demo} target="_blank" rel="noopener">Live app ↗</a>}
              {p.data.code && <a class="text-link" href={p.data.code} target="_blank" rel="noopener">Code and write-up ↗</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
    <h3 class="earlier-title">Earlier work</h3>
    <ul class="earlier">
      {earlierProjects.map((p) => (
        <li id={`project-${p.id}`}>
          <a href={p.data.code} target="_blank" rel="noopener">{p.data.short ?? p.data.title} ↗</a>
          <span>{p.data.oneLine}</span>
          <span class="earlier-where">{p.data.where}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="background">
  <div class="wrap wide background-grid">
    <div id="education">
      <h2>Education</h2>
      <ul class="edu-rows">
        {education.map((e) => (
          <li>
            <h3>{e.school}</h3>
            <p class="edu-degree">{e.degree}</p>
            <p class="edu-details">{e.details.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
    <div id="skills">
      <h2>Stack</h2>
      <dl class="stack-rows">
        {skills.map((s) => (
          <div><dt>{s.area}</dt><dd>{s.items.join(', ')}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap wide">
    <h2>About</h2>
    <div class="card about-card">
      <Fragment set:html={about} />
    </div>
  </div>
</section>

</main>

<Fragment slot="scripts">
<script is:inline>
// Old links to collapsed case studies (#case-...) now go to their own pages.
(function () {
  var map = { 'case-copilot': 'hr-copilot', 'case-rag': 'retrieval-pipeline', 'case-fishmeal': 'contract-allocation', 'case-fraud': 'fraud-detection' };
  var k = location.hash.slice(1);
  if (map[k]) location.replace('/work/' + map[k] + '/' + location.search);
})();
// Highlight the nav link of the section on screen.
(function () {
  if (!('IntersectionObserver' in window)) return;
  var links = {};
  document.querySelectorAll('.site-nav a.nav-link').forEach(function (a) { links[a.getAttribute('href').replace('/#', '')] = a; });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      Object.keys(links).forEach(function (k) { links[k].removeAttribute('aria-current'); });
      if (links[e.target.id]) links[e.target.id].setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  ['work', 'projects', 'about', 'contact'].forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
})();
</script>
</Fragment>
</Base>
