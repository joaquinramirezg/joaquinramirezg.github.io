<Fragment slot="head"><meta name="robots" content="noindex"></Fragment>
<main id="content">
<header class="page-head">
  <div class="wrap">
    <div class="kicker">404</div>
    <h1>That page does not exist</h1>
    <p class="lead">Nothing lives at this address. Start from the home page, with my work, projects, case studies, and how to reach me.</p>
    <div class="links">
      <a class="primary" href="/">Go to the home page</a>
      <a href="/#work">See my work</a>
      <a href="/#projects">See my projects</a>
    </div>
  </div>
</header>
</main>
</Base>
